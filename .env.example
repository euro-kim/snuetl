# Copy this file to .env. Set UID/GID to the Linux account that owns the bind directories.
SNUETL_CONTAINER_NAME=snuetl
SNUETL_UID=1000
SNUETL_GID=1000
SNUETL_TIMEZONE=Asia/Seoul

# Host paths only. snuetl stores the corresponding fixed container paths in config.toml.
# Use absolute paths for production deployments; do not use a literal '~'.
SNUETL_CONFIG_DIR=./docker-data/config
SNUETL_STATE_DIR=./docker-data/state
SNUETL_DOWNLOAD_DIR=./docker-data/downloads
SNUETL_VIDEO_DIR=./docker-data/videos
