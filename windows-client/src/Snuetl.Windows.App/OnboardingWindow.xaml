<Window x:Class="Snuetl.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snuetl.Windows"
        Title="SNUETL" Width="820" Height="760" MinWidth="680" MinHeight="620" WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F5F8">
        <StackPanel x:Name="ChoicePanel" Margin="36">
            <TextBlock Text="{local:Translate 'SNUETL 시작하기'}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,12"/>
            <TextBlock Text="{local:Translate '먼저 eTL 계정을 연결하세요. 연결 방법을 선택하면 다음 단계로 진행합니다.'}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,24"/>
            <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="{local:Translate '자동으로 연결'}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{local:Translate '임시 브라우저를 추가로 다운로드합니다. 서울대학교 계정으로 로그인하면 연결을 확인합니다.'}" TextWrapping="Wrap" Margin="0,12,0,18"/>
                <Button x:Name="AutomaticChoice" Content="{local:Translate '자동 연결 선택'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Automatic_Click"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="{local:Translate 'API 키로 직접 연결'}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{local:Translate '그림 안내에 따라 API 키를 발급하고 복사하세요.'}" TextWrapping="Wrap" Margin="0,12,0,18"/>
                <Button x:Name="ManualChoice" Content="{local:Translate 'API 키 직접 입력 선택'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Manual_Click"/>
            </StackPanel></Border>
            <TextBlock x:Name="ReadyText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid x:Name="ConnectionPanel" Visibility="Collapsed">
            <ContentControl x:Name="ConnectionHost"/>
        </Grid>
    </Grid>
</Window>
