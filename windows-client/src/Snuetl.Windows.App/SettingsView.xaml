<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Snuetl.Windows.SettingsView">
    <Grid Background="#F5F5F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource BrandBrush}" Padding="28,24">
            <DockPanel>
                <Border DockPanel.Dock="Left" Background="White" CornerRadius="10" Padding="6" Margin="0,0,16,0">
                    <Image x:Name="Logo" Width="44" Height="44"/>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="WelcomeText" Text="SNUETL 설정" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="수업 자료를 파일 탐색기에서 바로 열 수 있습니다." Foreground="#DCDAB2" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="24,20,24,0" BorderThickness="0" Background="Transparent">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="18,10"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabSurface" Property="BorderBrush" Value="#0F0F70"/>
                                        <Setter Property="Foreground" Value="#0F0F70"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background" Value="#EEEEF6"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background" Value="#E4E4F1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="일반">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="eTL 계정" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="AccountText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="AccountExpiryText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                                <StackPanel x:Name="SignInPanel">
                                    <TextBlock Text="자동 로그인용 브라우저는 필요할 때 설치되며, 연결 후 자동으로 정리됩니다." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
                                    <Button Content="자동 로그인" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Connect_Click"/>
                                    <Expander IsExpanded="True" Header="API 키로 연결" Margin="0,16,0,0">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="eTL 계정 설정에서 발급한 API 키 전체를 붙여 넣으세요." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                                            <PasswordBox x:Name="TokenBox" Padding="10" AutomationProperties.Name="eTL API 키"/>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Content="계정 연결" Click="ManualConnect_Click"/>
                                                <Button Content="API 키 발급 페이지" Click="TokenSettings_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <Button x:Name="SignOutButton" Content="로그아웃" HorizontalAlignment="Left" Click="SignOut_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="동기화 폴더" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="RootText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
                                <WrapPanel>
                                    <Button Content="폴더 열기" Click="Open_Click"/>
                                    <Button Content="폴더 선택…" Click="Browse_Click"/>
                                </WrapPanel>
                                <TextBlock Text="파일을 열면 내려받습니다. 로컬 수정 내용은 eTL에 업로드되지 않습니다." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="동기화 설정" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="StartupCheck" Content="Windows 로그인 시 자동 실행"/>
                                <TextBlock x:Name="StartupStatusText" TextWrapping="Wrap" Foreground="#666666" Margin="0,10"/>
                                <Button Content="자동 실행 복구" HorizontalAlignment="Left" Click="RepairStartup_Click"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <TextBlock Text="자동 동기화 간격" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="IntervalBox" Width="76" MaxLength="4" AutomationProperties.Name="동기화 간격 분" Text="15"/>
                                    <TextBlock Text="분" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="1~1,440분. 설정 저장 시 적용됩니다." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="알림 설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="받을 알림 선택" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="선택한 항목의 새 소식만 알립니다. Windows 알림 및 방해 금지 설정이 적용됩니다." TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,16"/>
                        <TextBlock Text="적용 강좌"/>
                        <ComboBox x:Name="NotificationCourse" SelectionChanged="NotificationCourse_Changed" Margin="0,8,0,16" DisplayMemberPath="Name"/>
                        <StackPanel x:Name="NotificationChoices"/>
                        <TextBlock Text="마감 몇 시간 전에 알릴까요? 쉼표로 구분" Margin="0,16,0,8"/>
                        <TextBox x:Name="ReminderHours" Text="24, 1" AutomationProperties.Name="Reminder offsets in hours"/>
                        <TextBlock x:Name="NotificationStatus" TextWrapping="Wrap" Foreground="#666666" Margin="0,16,0,0"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="로그인 구성 요소">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="자동 로그인" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="ComponentDescription" TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,16"/>
                        <CheckBox x:Name="DownloadConsent" IsChecked="True" Content="자동 로그인 구성 요소 다운로드" Margin="0,0,0,16"/>
                        <WrapPanel><Button Content="다운로드 및 설치" Click="InstallAddon_Click"/><Button Content="ZIP 파일로 설치…" Click="LocalAddon_Click"/><Button Content="구성 요소 제거" Click="RemoveAddon_Click"/></WrapPanel>
                        <TextBlock x:Name="ComponentStatus" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <TextBlock Text="구성 요소를 제거해도 연결된 계정과 파일 동기화는 유지됩니다." Foreground="#666666" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="모양">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="아이콘" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="트레이와 파일 탐색기에 표시할 아이콘을 선택하세요." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,22"/>
                                <Border Background="#F5F5F8" CornerRadius="12" Padding="22" Margin="0,0,0,22">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="White" CornerRadius="12" Padding="10">
                                            <Image x:Name="IconPreview" Width="64" Height="64"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                                            <TextBlock x:Name="IconChoiceText" FontWeight="SemiBold" FontSize="17"/>
                                            <TextBlock Text="파일 탐색기 및 트레이" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <WrapPanel>
                                    <Button Content="S 문자 아이콘" Click="DefaultIcon_Click" Margin="0,0,8,8"/>
                                    <Button Content="SNU 로고 기본값" Click="SnuIcon_Click" Margin="0,0,8,8"/>
                                    <Button Content="이미지 선택…" Style="{StaticResource PrimaryButton}" Click="CustomIcon_Click" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <TextBlock Text="PNG·JPG·BMP·ICO, 최대 10 MB. 기본 SNU 로고는 둥근 바탕으로 표시됩니다." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="정보 및 업데이트">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SNUETL Windows" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="VersionText" Foreground="{StaticResource BrandBrush}" FontSize="20" Margin="0,0,0,12"/>
                            <TextBlock Text="새 버전을 매주 확인합니다. 설치 시 계정과 동기화 폴더는 유지됩니다." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
                            <Expander Header="비공개 릴리스 접근 설정" Margin="0,0,0,16"><StackPanel Margin="0,12,0,0">
                                <TextBlock Text="비공개 릴리스에는 euro-kim/snuetl 저장소의 Contents 읽기 권한이 있는 GitHub 토큰이 필요합니다. Windows 자격 증명 관리자에 저장됩니다." TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,10"/>
                                <PasswordBox x:Name="GitHubTokenBox" Padding="10" AutomationProperties.Name="GitHub 릴리스 토큰"/>
                                <WrapPanel Margin="0,10,0,0"><Button Content="토큰 저장" Click="SaveGitHub_Click"/><Button Content="토큰 제거" Click="RemoveGitHub_Click"/></WrapPanel>
                                <TextBlock x:Name="GitHubAccessStatus" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel></Expander>
                            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="5" Visibility="Collapsed" Margin="0,0,0,12"/>
                            <WrapPanel><Button Content="새 버전 확인" Click="CheckUpdates_Click"/><Button x:Name="InstallUpdateButton" Content="업데이트 설치" Style="{StaticResource PrimaryButton}" Click="InstallUpdate_Click"/><Button Content="설치 파일 선택…" Click="Update_Click"/></WrapPanel>
                            <TextBlock Text="설치를 선택해야 업데이트를 내려받습니다." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SNUETL 제거" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="앱 설정과 저장된 인증 정보를 제거합니다. 내려받은 파일과 로컬 폴더는 보존되며, 온라인 전용 항목의 원본은 eTL에 남습니다." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                            <Button Content="SNUETL 제거…" Foreground="#B42335" BorderBrush="#F1BBC1" HorizontalAlignment="Left" Margin="0,18,0,0" Click="Uninstall_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Border x:Name="LoginPanel" Grid.Row="2" Visibility="Collapsed" Background="#EAEAF6" Padding="20,14" Margin="24,12,24,12" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="LoginProgressText" TextWrapping="Wrap" Foreground="#0F0F70" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar x:Name="LoginProgressBar" Minimum="0" Maximum="100" Height="6" Margin="0,10,0,0" AutomationProperties.Name="자동 로그인 진행 상태"/>
                </StackPanel>
                <Button x:Name="CancelLoginButton" Grid.Column="1" Content="취소" Margin="16,0,0,0" VerticalAlignment="Center" Click="CancelLogin_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E1E1EC" BorderThickness="0,1,0,0" Padding="24,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="설정 저장" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" Click="Done_Click"/>
                <TextBlock x:Name="FeedbackText" Text="변경한 설정은 저장 버튼을 눌러 적용하세요." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
