<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Snuetl.Windows" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Snuetl.Windows.SettingsView">
    <Grid Background="#F5F5F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource BrandBrush}" Padding="28,24">
            <DockPanel>
                <Button x:Name="OnboardingBack" DockPanel.Dock="Left" Content="{local:Translate '← 뒤로'}" Visibility="Collapsed" Click="OnboardingBack_Click" VerticalAlignment="Center" Margin="0,0,16,0" Padding="8,6" Foreground="White" Background="Transparent" BorderThickness="0"/>
                <Border DockPanel.Dock="Left" Background="White" CornerRadius="10" Padding="6" Margin="0,0,16,0">
                    <Image x:Name="Logo" Width="44" Height="44"/>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="WelcomeText" Text="{local:Translate 'SNUETL 설정'}" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="24,20,24,0" BorderThickness="0" Background="Transparent">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="18,10"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabSurface" Property="BorderBrush" Value="#0F0F70"/>
                                        <Setter Property="Foreground" Value="#0F0F70"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background" Value="#EEEEF6"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background" Value="#E4E4F1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="{local:Translate '일반'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GeneralStack" Margin="0,18,0,0">
                        <Border x:Name="AccountCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{local:Translate 'eTL 계정'}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="AccountText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="AccountExpiryText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                                <Button x:Name="SignOutButton" Content="{local:Translate '로그아웃'}" HorizontalAlignment="Left" Click="SignOut_Click"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="SignInPanel">
                            <Border x:Name="AutomaticCard" Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="{local:Translate '자동으로 연결'}" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="{local:Translate '임시 브라우저를 추가로 다운로드합니다. 서울대학교 계정으로 로그인하면 연결을 확인합니다.'}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
                                <Button Content="{local:Translate '자동으로 연결'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Connect_Click"/>
                            </StackPanel></Border>
                            <Border x:Name="ManualCard" Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="{local:Translate 'API 키로 직접 연결'}" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="{local:Translate '그림 안내에 따라 API 키를 발급하고 복사하세요.'}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>

                                <Expander Header="{local:Translate 'API 키 발급 안내'}" x:Name="ManualGuide" IsExpanded="True" Margin="0,4,0,0">
                                    <StackPanel Margin="0,12,0,0">
                                        <Button Content="{local:Translate 'API 키 발급 페이지'}" Click="TokenSettings_Click" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{local:Translate '1. eTL에서 Account(계정) → Settings(설정)를 엽니다.'}" TextWrapping="Wrap" Margin="0,12,0,8"/>
                                        <Image Source="Assets/token-step-1.png" MaxWidth="640" Stretch="Uniform"/>
                                        <TextBlock Text="{local:Translate '2. Approved Integrations에서 New Access Token을 선택합니다.'}" TextWrapping="Wrap" Margin="0,16,0,8"/>
                                        <Image Source="Assets/token-step-2.png" MaxWidth="640" Stretch="Uniform"/>
                                        <TextBlock Text="{local:Translate '3. Purpose에 SNUETL을 입력하고 만료일을 선택한 뒤 Generate Token을 누릅니다.'}" TextWrapping="Wrap" Margin="0,16,0,8"/>
                                        <Image Source="Assets/token-step-3.png" MaxWidth="640" Stretch="Uniform"/>
                                        <TextBlock Text="{local:Translate '4. Token 값 전체를 복사하세요. 한 번만 표시됩니다. 아래에 붙여 넣으세요.'}" TextWrapping="Wrap" Margin="0,16,0,8"/>
                                        <Image x:Name="TokenCopyImage" Source="Assets/token-step-4.png" MaxWidth="640" Stretch="Uniform"/>
                                    </StackPanel>
                                </Expander>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                                    <TextBlock Text="{local:Translate 'API 키 붙여 넣기'}" VerticalAlignment="Center"/>
                                    <Border x:Name="TokenHelp" Width="18" Height="18" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource MutedBrush}" Background="Transparent" Margin="8,0,0,0" Cursor="Help" ToolTipService.InitialShowDelay="150" AutomationProperties.Name="{local:Translate 'API 키 저장 안내'}">
                                        <Border.ToolTip>
                                            <ToolTip><TextBlock Text="{local:Translate 'eTL에서 유효한 키로 확인된 후에만 안전하게 저장합니다.'}" TextWrapping="Wrap" MaxWidth="320"/></ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{local:Translate '붙여 넣기'}" Click="PasteToken_Click" Margin="8,0,0,0"/>
                                    <PasswordBox x:Name="TokenBox" Padding="10" AutomationProperties.Name="{local:Translate 'eTL API 키'}"/>
                                </DockPanel>
                                <Button Content="{local:Translate '연결 확인 후 저장'}" Click="ManualConnect_Click" HorizontalAlignment="Right" Margin="0,12,0,0"/>

                            </StackPanel></Border>
                        </StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{local:Translate '동기화 폴더'}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="RootText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
                                <WrapPanel>
                                    <Button Content="{local:Translate '폴더 열기'}" Click="Open_Click"/>
                                    <Button Content="{local:Translate '폴더 선택…'}" Click="Browse_Click"/>
                                </WrapPanel>
                                <TextBlock Text="{local:Translate '파일을 열면 내려받습니다. 로컬 수정 내용은 eTL에 업로드되지 않습니다.'}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{local:Translate '동기화 설정'}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{local:Translate '언어'}"/>
                                <ComboBox x:Name="LanguageChoice" SelectedValuePath="Tag" Margin="0,8" SelectionChanged="Language_Changed">
                                    <ComboBoxItem Tag="system" Content="{local:Translate 'Windows 언어 사용'}"/>
                                    <ComboBoxItem Tag="ko" Content="한국어"/>
                                    <ComboBoxItem Tag="en" Content="English"/>
                                </ComboBox>

                                <CheckBox x:Name="StartupCheck" Content="{local:Translate 'Windows 로그인 시 자동 실행'}"/>
                                <TextBlock x:Name="StartupStatusText" TextWrapping="Wrap" Foreground="#666666" Margin="0,10"/>
                                <Button Content="{local:Translate '자동 실행 복구'}" HorizontalAlignment="Left" Click="RepairStartup_Click"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <TextBlock Text="{local:Translate '자동 동기화 간격'}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="IntervalBox" Width="76" MaxLength="4" AutomationProperties.Name="{local:Translate '동기화 간격 분'}" Text="15"/>
                                    <TextBlock Text="{local:Translate '분'}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{local:Translate '1~1,440분. 설정 저장 시 적용됩니다.'}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Translate '알림 설정'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="{local:Translate '받을 알림 선택'}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{local:Translate '선택한 항목의 새 소식만 알립니다. Windows 알림 및 방해 금지 설정이 적용됩니다.'}" TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,16"/>
                        <TextBlock Text="{local:Translate '적용 강좌'}"/>
                        <ComboBox x:Name="NotificationCourse" SelectionChanged="NotificationCourse_Changed" Margin="0,8,0,16" DisplayMemberPath="Name"/>
                        <StackPanel x:Name="NotificationChoices"/>
                        <TextBlock Text="{local:Translate '마감 몇 시간 전에 알릴까요? 쉼표로 구분'}" Margin="0,16,0,8"/>
                        <TextBox x:Name="ReminderHours" Text="24, 1" AutomationProperties.Name="Reminder offsets in hours"/>
                        <TextBlock x:Name="NotificationStatus" TextWrapping="Wrap" Foreground="#666666" Margin="0,16,0,0"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Translate '로그인 구성 요소'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="{local:Translate '자동 로그인'}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="ComponentDescription" TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,16"/>
                        <CheckBox x:Name="DownloadConsent" IsChecked="True" Content="{local:Translate '자동 로그인 구성 요소 다운로드'}" Margin="0,0,0,16"/>
                        <WrapPanel><Button Content="{local:Translate '다운로드 및 설치'}" Click="InstallAddon_Click"/><Button Content="{local:Translate 'ZIP 파일로 설치…'}" Click="LocalAddon_Click"/><Button Content="{local:Translate '구성 요소 제거'}" Click="RemoveAddon_Click"/></WrapPanel>
                        <TextBlock x:Name="ComponentStatus" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <TextBlock Text="{local:Translate '구성 요소를 제거해도 연결된 계정과 파일 동기화는 유지됩니다.'}" Foreground="#666666" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Translate '모양'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{local:Translate '아이콘'}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{local:Translate '트레이와 파일 탐색기에 표시할 아이콘을 선택하세요.'}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,22"/>
                                <Border Background="#F5F5F8" CornerRadius="12" Padding="22" Margin="0,0,0,22">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="White" CornerRadius="12" Padding="10">
                                            <Image x:Name="IconPreview" Width="64" Height="64"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                                            <TextBlock x:Name="IconChoiceText" FontWeight="SemiBold" FontSize="17"/>
                                            <TextBlock Text="{local:Translate '파일 탐색기 및 트레이'}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <WrapPanel>
                                    <Button Content="{local:Translate 'S 문자 아이콘'}" Click="DefaultIcon_Click" Margin="0,0,8,8"/>
                                    <Button Content="{local:Translate 'SNU 로고 기본값'}" Click="SnuIcon_Click" Margin="0,0,8,8"/>
                                    <Button Content="{local:Translate '이미지 선택…'}" Style="{StaticResource PrimaryButton}" Click="CustomIcon_Click" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <TextBlock Text="{local:Translate 'PNG·JPG·BMP·ICO, 최대 10 MB. 기본 SNU 로고는 둥근 바탕으로 표시됩니다.'}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Translate '정보 및 업데이트'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SNUETL Windows" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="VersionText" Foreground="{StaticResource BrandBrush}" FontSize="20" Margin="0,0,0,12"/>
                            <TextBlock Text="{local:Translate '새 버전을 매주 확인합니다. 설치 시 계정과 동기화 폴더는 유지됩니다.'}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
                            <Expander Header="{local:Translate '비공개 릴리스 접근 설정'}" Margin="0,0,0,16"><StackPanel Margin="0,12,0,0">
                                <TextBlock Text="{local:Translate '비공개 릴리스에는 euro-kim/snuetl 저장소의 Contents 읽기 권한이 있는 GitHub 토큰이 필요합니다. Windows 자격 증명 관리자에 저장됩니다.'}" TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,10"/>
                                <PasswordBox x:Name="GitHubTokenBox" Padding="10" AutomationProperties.Name="{local:Translate 'GitHub 릴리스 토큰'}"/>
                                <WrapPanel Margin="0,10,0,0"><Button Content="{local:Translate '토큰 저장'}" Click="SaveGitHub_Click"/><Button Content="{local:Translate '토큰 제거'}" Click="RemoveGitHub_Click"/></WrapPanel>
                                <TextBlock x:Name="GitHubAccessStatus" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel></Expander>
                            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="5" Visibility="Collapsed" Margin="0,0,0,12"/>
                            <WrapPanel><Button Content="{local:Translate '새 버전 확인'}" Click="CheckUpdates_Click"/><Button x:Name="InstallUpdateButton" Content="{local:Translate '업데이트 설치'}" Style="{StaticResource PrimaryButton}" Click="InstallUpdate_Click"/><Button Content="{local:Translate '설치 파일 선택…'}" Click="Update_Click"/></WrapPanel>
                            <TextBlock Text="{local:Translate '설치를 선택해야 업데이트를 내려받습니다.'}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{local:Translate 'SNUETL 제거'}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{local:Translate '앱 설정과 저장된 인증 정보를 제거합니다. 내려받은 파일과 로컬 폴더는 보존되며, 온라인 전용 항목의 원본은 eTL에 남습니다.'}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                            <Button Content="{local:Translate 'SNUETL 제거…'}" Foreground="#B42335" BorderBrush="#F1BBC1" HorizontalAlignment="Left" Margin="0,18,0,0" Click="Uninstall_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Border x:Name="LoginPanel" Grid.Row="2" Visibility="Collapsed" Background="#EAEAF6" Padding="20,14" Margin="24,12,24,12" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="LoginProgressText" TextWrapping="Wrap" Foreground="#0F0F70" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar x:Name="LoginProgressBar" Minimum="0" Maximum="100" Height="6" Margin="0,10,0,0" AutomationProperties.Name="{local:Translate '자동 로그인 진행 상태'}"/>
                </StackPanel>
                <Button x:Name="CancelLoginButton" Grid.Column="1" Content="{local:Translate '취소'}" Margin="16,0,0,0" VerticalAlignment="Center" Click="CancelLogin_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E1E1EC" BorderThickness="0,1,0,0" Padding="24,16">
            <DockPanel>
                <Button x:Name="SaveSettingsButton" DockPanel.Dock="Right" Content="{local:Translate '설정 저장'}" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" Click="Done_Click"/>
                <TextBlock x:Name="FeedbackText" Text="" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
