<Window x:Class="Snuetl.Windows.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SNUETL · Dashboard" Width="1100" Height="780" MinWidth="780" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#F5F5F8">
 <Grid Background="#F5F5F8"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#0F0F70" Padding="22,30"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="SNUETL" Foreground="White" FontSize="27" FontWeight="Bold"/><TextBlock Text="Your academic companion" Foreground="#DCDAB2" Margin="0,8,0,30"/>
    <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="Navigate" FontSize="16">
     <ListBox.Resources><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,14"/><Setter Property="Margin" Value="0,3"/></Style></ListBox.Resources>
     <ListBoxItem Content="Overview"/><ListBoxItem Content="Courses"/><ListBoxItem Content="Deadlines"/><ListBoxItem Content="Notifications"/><ListBoxItem Content="Files &amp; activity"/><ListBoxItem Content="Settings"/>
    </ListBox>
   </StackPanel>
   <StackPanel VerticalAlignment="Bottom"><Button Content="Open eTL ↗" Click="OpenEtl"/><TextBlock Text="Read-only Canvas client" Foreground="#DCDAB2" FontSize="11" Margin="0,14,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid x:Name="DashboardContent" Grid.Column="1" Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel><Button x:Name="SyncButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Refresh"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="SyncLabel" Text="Sync now" FontWeight="SemiBold"/></StackPanel></Button><TextBlock x:Name="Heading" Text="Overview" FontSize="30" FontWeight="SemiBold"/></DockPanel>
   <TextBlock Grid.Row="1" x:Name="StatusText" Foreground="#666666" Margin="0,12,0,14" TextWrapping="Wrap"/>
   <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="#A3212A" TextWrapping="Wrap" Margin="0,0,0,14"/>
   <Grid Grid.Row="3">
    <ListBox x:Name="Rows" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,10"><StackPanel>
      <DockPanel Margin="0,0,0,8"><Border Background="{Binding BadgeBackground}" CornerRadius="8" Padding="8,6" Margin="0,0,10,0"><TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeColor}" FontWeight="Bold" FontSize="11"/></Border><TextBlock Text="{Binding Label}" Foreground="#666666" FontSize="11" VerticalAlignment="Center"/></DockPanel>
      <Button Content="{Binding Title}" Tag="{Binding}" Click="OpenRow" HorizontalAlignment="Left" FontWeight="SemiBold" FontSize="16" Padding="0,4" Background="Transparent" BorderThickness="0"><Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="680"/></DataTemplate></Button.ContentTemplate></Button>
      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#666666" Margin="0,6,0,4"/>
      <Button Content="{Binding Action}" Tag="{Binding}" Click="OpenDirectory" HorizontalAlignment="Left" Padding="0,6" Background="Transparent" BorderThickness="0" Foreground="#0F0F70"/>
     </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="Empty" Text="No items to show. Connect your account in Settings, then refresh." TextWrapping="Wrap" Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
  </Grid>
  <ContentControl x:Name="SettingsHost" Grid.Column="1" Visibility="Collapsed"/>
 </Grid>
</Window>
